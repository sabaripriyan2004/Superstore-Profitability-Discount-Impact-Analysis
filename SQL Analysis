Which product categories and sub-categories are the most profitable, and which are consistently losing money?
SELECT Category,
       COUNT(*)                AS orders,
       ROUND(SUM(Sales), 2)    AS sales,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Category
ORDER BY profit DESC;
 
-- 1b. Sub-category level (best to worst)
SELECT Category,
       Sub_Category,
       COUNT(*)                AS orders,
       ROUND(SUM(Sales), 2)    AS sales,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Category, Sub_Category
ORDER BY profit DESC;
 
-- 1c. Only the loss-making sub-categories
SELECT Category,
       Sub_Category,
       ROUND(SUM(Sales), 2)  AS sales,
       ROUND(SUM(Profit), 2) AS profit
FROM superstore
GROUP BY Category, Sub_Category
HAVING SUM(Profit) < 0
ORDER BY profit;
 
-- 1d. "Consistently" losing: profit by sub-category for each year
SELECT Sub_Category,
       YEAR(Order_Date)      AS order_year,
       ROUND(SUM(Profit), 2) AS profit
FROM superstore
GROUP BY Sub_Category, YEAR(Order_Date)
ORDER BY Sub_Category, order_year;
 
-- 1e. Sub-categories that lost money in EVERY year
SELECT Sub_Category,
       COUNT(*) AS years_with_data,
       SUM(CASE WHEN yearly_profit < 0 THEN 1 ELSE 0 END) AS loss_years
FROM (
    SELECT Sub_Category,
           YEAR(Order_Date) AS yr,
           SUM(Profit)      AS yearly_profit
    FROM superstore
    GROUP BY Sub_Category, YEAR(Order_Date)
) t
GROUP BY Sub_Category
HAVING loss_years > 0
ORDER BY loss_years DESC, Sub_Category;
-- If loss_years = years_with_data, it lost money every single year.

Which regions and states generate the highest profit, and which are reducing overall profitability?

SELECT Region,
       COUNT(*)                AS orders,
       ROUND(SUM(Sales), 2)    AS sales,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Region
ORDER BY margin_pct DESC;
 
-- 2b. Top 10 most profitable states
SELECT State,
       ROUND(SUM(Sales), 2)  AS sales,
       ROUND(SUM(Profit), 2) AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY State
ORDER BY profit DESC
LIMIT 10;
 
-- 2c. All loss-making states (the ones dragging profit down)
SELECT State,
       Region,
       ROUND(SUM(Sales), 2)  AS sales,
       ROUND(SUM(Profit), 2) AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY State, Region
HAVING SUM(Profit) < 0
ORDER BY profit;
 
-- 2d. How many loss-making states does each region have?
SELECT Region,
       COUNT(*)              AS loss_making_states,
       ROUND(SUM(state_profit), 2) AS total_state_losses
FROM (
    SELECT Region, State, SUM(Profit) AS state_profit
    FROM superstore
    GROUP BY Region, State
    HAVING SUM(Profit) < 0
) t
GROUP BY Region
ORDER BY total_state_losses;
 
-- 2e. Why is a state losing? Check its average discount
SELECT State,
       ROUND(AVG(Discount) * 100, 1) AS avg_discount_pct,
       ROUND(SUM(Profit), 2)         AS profit
FROM superstore
WHERE State IN ('Texas', 'Ohio', 'Pennsylvania', 'Illinois')
GROUP BY State
ORDER BY profit;

Is there a relationship between discount percentage and profit? At what discount level does profitability become negative?

SELECT Discount_Bucket,
       COUNT(*)                AS orders,
       ROUND(SUM(Sales), 2)    AS sales,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Discount_Bucket
ORDER BY FIELD(Discount_Bucket, 'No Discount', 'Low', 'Medium', 'High', 'Very High');
 
-- 3b. Exact discount levels: find the tipping point
SELECT Discount,
       COUNT(*)                AS orders,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Discount
ORDER BY Discount;
-- Read down margin_pct: the first discount where it goes below 0 is the tipping point.
 
-- 3c. Correlation between discount and profit (Pearson)
SELECT ROUND(
         (AVG(Discount * Profit) - AVG(Discount) * AVG(Profit)) /
         ( SQRT(AVG(Discount * Discount) - AVG(Discount) * AVG(Discount)) *
           SQRT(AVG(Profit * Profit)     - AVG(Profit)   * AVG(Profit)) )
       , 3) AS discount_profit_correlation
FROM superstore;
-- A negative number means: higher discount, lower profit.
 
-- 3d. Share of orders and total loss that come from heavy discounts
SELECT Discount_Bucket,
       COUNT(*) AS orders,
       ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM superstore), 1) AS pct_of_orders,
       ROUND(SUM(CASE WHEN Profit < 0 THEN Profit ELSE 0 END), 2)     AS total_losses
FROM superstore
GROUP BY Discount_Bucket
ORDER BY total_losses;
 
-- 3e. Does discount hurt every category? (margin by category x bucket)
SELECT Category,
       Discount_Bucket,
       COUNT(*) AS orders,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct
FROM superstore
GROUP BY Category, Discount_Bucket
ORDER BY Category,
         FIELD(Discount_Bucket, 'No Discount', 'Low', 'Medium', 'High', 'Very High');

SELECT Segment,
       COUNT(*)                AS orders,
       COUNT(DISTINCT Customer_ID) AS customers,
       ROUND(SUM(Sales), 2)    AS sales,
       ROUND(SUM(Profit), 2)   AS profit,
       ROUND(SUM(Profit) / SUM(Sales) * 100, 2) AS margin_pct,
       ROUND(AVG(Discount) * 100, 1)            AS avg_discount_pct
FROM superstore
GROUP BY Segment
ORDER BY margin_pct DESC;
