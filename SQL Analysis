What are the top 10 loss-making products, and what do they have in common in terms of category, discount level, and region?
SELECT
    Product_ID,
    Product_Name,
    Category,
    Sub_Category,
    Region,
    State,
    COUNT(DISTINCT Order_ID) AS Total_Orders,
    SUM(Quantity) AS Total_Quantity_Sold,
    SUM(Sales) AS Total_Sales,
    SUM(Profit) AS Total_Profit,
    AVG(Discount) AS Average_Discount,
    AVG(Profit) AS Average_Profit,
    ROUND(
        SUM(Profit) / NULLIF(SUM(Sales), 0) * 100, 2
    ) AS Profit_Margin_Percentage
FROM Superstore
GROUP BY
    Product_ID,
    Product_Name,
    Category,
    Sub_Category,
    Region,
    State
HAVING
    SUM(Profit) < 0
ORDER BY
    Total_Profit ASC
LIMIT 10;

